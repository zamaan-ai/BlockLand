# ======================
# BlockLand Environment
# ======================

# Database (matches docker-compose)
DATABASE_URL="postgresql://blockland:blockland@localhost:5432/blockland?schema=public"

# API
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-also-long-random"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MAP_TILE_STYLE=carto
# CARTO Basemaps browser key; put it in apps/web/.env.local and restrict allowed hosts in CARTO.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# Redis (optional — enables cache + BullMQ document worker)
REDIS_URL="redis://localhost:6379"

# Blockchain (local Hardhat / Sepolia)
CHAIN_RPC_URL="http://127.0.0.1:8545"
REGISTRY_CONTRACT_ADDRESS=
GOVERNMENT_SIGNER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional integrations
PINATA_JWT=
PINATA_GATEWAY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GOOGLE_CLIENT_ID=
