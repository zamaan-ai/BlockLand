DATABASE_URL="postgresql://postgres:password@localhost:5432/blockland"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# IPFS / Pinata (optional — demo CID generated if empty)
PINATA_API_KEY=""
PINATA_SECRET_KEY=""
PINATA_JWT=""

# Email / Nodemailer (json transport if SMTP_HOST empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BlockLand <noreply@blockland.local>"

# Redis cache + BullMQ (in-memory fallback if empty)
REDIS_URL=""

# Twilio SMS OTP (demo code 123456 if empty)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
OTP_DEMO=true
OTP_DEMO_CODE=123456

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_OAUTH_DEMO=true
